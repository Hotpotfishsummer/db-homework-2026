# Weather API (和风天气: https://dev.qweather.com/)
HEFENG_API_KEY=your_hefeng_api_key_here
HEFENG_API_HOST=your_host.re.qweatherapi.com

# DeepSeek official API for outfit/recommendation agents
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Generic OpenAI-compatible fallback API
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
AGENT_MAX_ITERATIONS=3

# Optional multimodal LLM for garment image upload/detection/tagging.
# Falls back to LLM_API_KEY / LLM_API_BASE / LLM_MODEL when omitted.
VISION_API_KEY=
VISION_API_BASE=
VISION_MODEL=gpt-4o-mini

# When true, all LLM features require the user-supplied frontend LLM headers.
# Server-side DEEPSEEK_*, VISION_*, and LLM_* credentials are not used.
USER_LLM_ONLY=false

# Database
# Local PostgreSQL (recommended for development and Docker deployment)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/l_wardrobe

# Neon / cloud PostgreSQL compatibility example
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require

# Application
APP_NAME=L-Wardrobe
DEBUG=true
SECRET_KEY=change-me-in-production
# Log level: DEBUG / INFO / WARNING / ERROR / CRITICAL (independent of DEBUG flag)
LOG_LEVEL=INFO
