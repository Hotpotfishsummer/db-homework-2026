# Weather API (和风天气: https://dev.qweather.com/)
HEFENG_API_KEY=your_hefeng_api_key_here
HEFENG_API_HOST=your_host.re.qweatherapi.com

# LLM API (e.g. OpenAI, Anthropic, or local endpoint)
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://api.openai.com/v1
# 确保使用带多模态功能的模型, 需要支持图像输入的模型
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
AGENT_MAX_ITERATIONS=3

# DeepSeek API (穿搭推荐)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Database
# Local PostgreSQL (recommended for development and Docker deployment)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/l_wardrobe

# Neon / cloud PostgreSQL compatibility example
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require

# Application
APP_NAME=L-Wardrobe
DEBUG=true
SECRET_KEY=change-me-in-production
# Log level: DEBUG / INFO / WARNING / ERROR / CRITICAL (independent of DEBUG flag)
LOG_LEVEL=INFO
